# MongoDB connection string
DATABASE_URI=mongodb://localhost:27017/bookstore
# Port the API listens on
PORT=3333
# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts
JWT_EXPIRES_IN=7d
# Comma-separated emails that become admins when they register
ADMIN_EMAILS=admin@example.com
# Folder for uploaded cover images (default: backend/uploads)
# UPLOAD_DIR=/data/uploads
