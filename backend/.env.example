# MongoDB connection string
DATABASE_URI=mongodb://localhost:27017/bookstore
# Port the API listens on
PORT=3333
# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Secret used to sign login tokens. In production it must be 32+ random characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts
JWT_EXPIRES_IN=7d
# Comma-separated emails that become admins when they register
ADMIN_EMAILS=admin@example.com
# Folder for uploaded cover images (default: backend/uploads)
# UPLOAD_DIR=/data/uploads
# Set to 1 when running behind a reverse proxy so rate limits use the real client IP
# TRUST_PROXY=1
# Requests allowed per IP per 15 minutes: failed logins/sign-ups, and all API calls
# AUTH_RATE_LIMIT=10
# API_RATE_LIMIT=1000
